{
  "schemaVersion": 1,
  "id": "ccrj45",
  "version": "${mod_version}",
  "name": "CC:RJ45",
  "description": "CC:RJ45 adds cable connectors, dyeable data storage (cassettes and hard drives), and disk shelves for ComputerCraft wired networks.",
  "authors": [
    "Cyber_Jellyfish"
  ],
  "contact": {
    "homepage": "https://github.com/1cyberjellyfish/CC-RJ45",
    "sources": "https://github.com/1cyberjellyfish/CC-RJ45"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.cyber_jellyfish.cc_rj45.fabric.CCRJ45Fabric"
    ],
    "client": [
      "net.cyber_jellyfish.cc_rj45.fabric.CCRJ45FabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "computercraft": "*"
  }
}
